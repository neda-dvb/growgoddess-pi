# Cannabits Edge Gateway — environment
# Copy to /etc/cannabits/gateway.env (chmod 600) and fill in.
#
# These override the config file, so the secret never lives in gateway.json.

# The PUBLIC Cannabits backend (never a LAN address).
CANNABITS_API_URL=https://growgoddess.club

# The gateway's API key: a cbk_... credential minted in Cannabits Pro for THIS
# plan (POST /api/pro/plans/:id/api-keys, or the gateway-key control in the UI).
CANNABITS_API_KEY=cbk_replace_me
