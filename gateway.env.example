# Cannabits Edge Gateway — environment
# /etc/cannabits/gateway.env, root:root 0600 (systemd reads it before it drops
# to the service user). These override the config file, so the secret never
# lives in gateway.json.

# The PUBLIC Cannabits backend (never a LAN address). https only.
CANNABITS_API_URL=https://growgoddess.club

# A plan key (POST /api/pro/plans/:id/api-keys), only for a facility whose
# gateways have not enrolled. `sudo cannabits-gateway enroll <code>` keeps the
# gateway's own key in /var/lib/cannabits-gateway/gateway.key instead, and
# that key wins over this line.
CANNABITS_API_KEY=cbk_replace_me
